{
    "venv": ".venv",
    "venvPath": ".",
    "include": [
        "app",
        "main.py"
    ],
    "exclude": [
        "**/__pycache__"
    ],
    "pythonVersion": "3.12",
    "pythonPlatform": "Windows",
    "typeCheckingMode": "basic",
    "useLibraryCodeForTypes": true,
    "reportMissingImports": true,
    "reportMissingTypeStubs": false,
    "extraPaths": [
        ".",
        "./app",
        "./.venv/Lib/site-packages"
    ]
}