{
    "include": [
        "app",
        "*.py"
    ],
    "exclude": [
        "**/__pycache__",
        ".venv"
    ],
    "pythonVersion": "3.12",
    "pythonPlatform": "Windows",
    "typeCheckingMode": "basic",
    "useLibraryCodeForTypes": true,
    "reportMissingImports": true,
    "reportMissingTypeStubs": false,
    "venvPath": "C:/MindX",
    "venv": ".venv",
    "extraPaths": [
        "C:/MindX",
        "C:/MindX/app"
    ]
}